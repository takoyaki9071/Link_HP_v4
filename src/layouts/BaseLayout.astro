---
/**
 * 共通レイアウト: <head>（OGP/favicon）・スキップリンク・ヘッダー・フッター。
 * 色や書体は tokens.css、共通部品は components.css に集約する。
 */
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WorldCanvas from '../components/WorldCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

// TODO(確認事項#1): 団体説明確定後に description も差し替える。
const {
  title = 'Link 公式ホームページ',
  description = 'Linkの公式ホームページです。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Link" />
    <meta property="og:image" content="/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- ブラウザUI（アドレスバー等）の色。ダーク指定時は下のスクリプトが差し替える -->
    <meta name="theme-color" content="#ffffff" />
    <!-- 表示モードの初期化（描写前に行って切り替えのちらつきを防ぐ）:
         1) localStorage の手動選択（ヘッダーのトグル）が最優先
         2) 未選択なら OS の prefers-color-scheme に追従（OS 変化も追従）
         JS 無効環境では以降のメディアクエリ（tokens.css）がそのまま効く -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem('link-theme');
        } catch (e) {}
        if (saved === 'dark' || saved === 'light') {
          root.dataset.theme = saved;
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          root.dataset.theme = 'dark';
        }
        // 手動選択がされた後は保存値が優先（localStorage を見て追従をやめる）
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var onSys = function (event) {
          var s = null;
          try {
            s = localStorage.getItem('link-theme');
          } catch (e) {}
          if (s === 'dark' || s === 'light') return;
          root.dataset.theme = event.matches ? 'dark' : 'light';
        };
        if (typeof mq.addEventListener === 'function') {
          mq.addEventListener('change', onSys);
        }
      })();
      // meta theme-color を現在のモードに合わせる（トグル・OS 変化の両方に追従）
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        var apply = function () {
          meta.setAttribute('content',
            document.documentElement.dataset.theme === 'dark' ? '#0b0b0b' : '#ffffff');
        };
        apply();
        new MutationObserver(apply).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
    <!-- JS 有効判定（.reveal の CSS は html.js 配下でのみ非表示になる。JS無効環境では常時表示） -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <!-- ページ全体の世界 Canvas: 本文（main z-index:1）の下に多様な図形（立体/真球/長い線/点）を
         敷く。外せば元に戻る（WorldCanvas.astro のヘッダーコメント参照） -->
    <WorldCanvas />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- 控えめなスクロール演出（2026-10-18 承認）:
         .reveal を表示1度きりフェードアップ。reduced-motion では即時全表示。
         主要情報を長く隠さないため遅延は最大240ms・ホーム設計プラン §4 の改定を参照。
         なお html.intro-wait がある間（開幕演出中）は開幕の発表まで待ってから始める。 -->
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const showAll = () => {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      };

      let started = false;
      function startReveal() {
        if (started) return;
        started = true;
        if (reduced || !('IntersectionObserver' in window)) {
          showAll();
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 開幕演出（IntroCanvas・ホームのみ）が走っている間は待つ。保険のタイムアウト付き
      if (document.documentElement.classList.contains('intro-wait')) {
        window.addEventListener('link:intro-done', startReveal, { once: true });
        window.setTimeout(startReveal, 4600);
      } else {
        startReveal();
      }
    </script>
  </body>
</html>
